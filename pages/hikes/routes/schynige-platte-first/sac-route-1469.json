pe":"mountain_hiking","discipline":"mountain_hiking"}],"seriousness":1,"teaser":"Der Weg von der Bergstation der Gondelbahn Grindelwald–First (2165 m) aufs Faulhorn (2681 m) ist beliebt und wird häufig begangen, denn die Aussicht unterwegs und erst recht vom Gipfel des Faulhorns ist atemberaubend. Vom Faulhorn erreicht man das Berghaus Männdlenen leicht absteigend in weniger als einer Stunde.","teaser_title":"Auf viel begangenem Weg via Faulhorn zum Berghaus Männdlenen","title":"Von First","type":"mountain_hiking","via_ferrata_ascent":null,"via_ferrata_descent":null,"waypoints":[{"description":"Mit gleichnamigem Berghotel https:\/\/www.faulhorn.ch\/","id":190434,"name":"Faulhorn","reference_poi":{"altitude":2681,"description_summer":"Wahrscheinlich einer der am häufigsten von Wanderern besuchte Gipfel der Schweiz. Jeden Sommer ziehen ganze Völkerstämme von der Schynigen Platte hinüber zur Grindelwald-First-Bergstation, wobei der Faulhorn-Gipfel überschritten wird. Das 1832 in der S-Flanke errichtete  <a href=\"https:\/\/www.faulhorn.ch\/\">Hotel<\/a> samt Nebengebäuden sah und sieht sämtliche Liebhaber von Sonnenaufgängen alljährlich vorüberwandern. Der Gipfel gibt einen relativ freistehenden Aussichtspunkt ab. Er weist eine begraste Südflanke und eine steile, felsige Nordflanke auf und bietet das Bild eines eher eintönigen Berges.","description_winter":"Faulhorn is a viewpoint which is very often visited by winter hikers with and without a sledge. Ski tourists ascend this summit, when the snow conditions promise pleasurable descents. Faulhorn is also traversed on the way to Schonegg. The historical Faulhorn hotel is closed in winter.","display_name":"Faulhorn","geom":{"type":"Point","coordinates":[2642883.0006086007,1169442.8759673301]},"id":597,"linked_routes_by_discipline_denormalization":null,"main_lang":"de","type":"summit"},"reference_poi_id":597}],"permissions":{"update":false,"delete":false,"status_transitions":[],"is_locked":false,"unlock":false},"main_difficulty":"T2","route_info":{"list":[{"icon":"knob","label":"Difficulty","value":"T2","type":"difficulty","discipline":"mountain_hiking"},{"icon":"arrow2-top-right","label":"Ascent","value":"3–3:30 h, 570 m"},{"icon":"arrow2-bottom-right","label":"Descent","value":"380 m"}]},"discipline_season":"summer","all_additional_informations":[{"label":"Departure point","description":{"title":"First (Grindelwald) (2165 m)","public_transport_stop_comment":"Bergstation der Seilbahn Grindelwald – Bort – Schreckfeld – First. Sommer- und Winterbetrieb.","parking_lot":""},"mapLink":{"label":"Show on map","options":"\"routeId\":\"1469\", \"segmentsMode\": \"true\", \"zoomLevel\":\"9\", \"poiId\":\"6782\", \"center\":[2647067.3756132,1167814.6935921]"},"googleMapsLink":{"label":"Get there Google Maps","typolink":"\/en\/redirect\/google-maps-routing\/lv03\/2647067.3756132\/1167814.6935921.gmaps","target":"_blank"},"publicTransport":{"label":"First (Grindelwald)","stopId":8507354,"timetableLink":"https:\/\/www.sbb.ch\/en\/buying\/pages\/fahrplan\/fahrplan.xhtml?language=en&von=&nach=First+%28Grindelwald%29","means_of_transport":"Kabinenbahn","icon":"transport-kabinenbahn","target":"_blank"}},{"label":"Waypoints","description":{"title":"Faulhorn (2681 m)","description":"Mit gleichnamigem Berghotel https:\/\/www.faulhorn.ch\/","poiId":597},"mapLink":{"label":"Show on map","options":"\"routeId\":\"1469\", \"segmentsMode\": \"true\", \"zoomLevel\":\"9\", \"poiId\":\"597\", \"center\":[2642883.0006086,1169442.8759673]"}}]}