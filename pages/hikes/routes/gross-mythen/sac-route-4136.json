45_2001392707M.jpg","1200x750":"https:\/\/static.www.suissealpine.sac-cas.ch\/1555335945_2001392707Ma.jpg","500x313":"https:\/\/static.www.suissealpine.sac-cas.ch\/1555335945_2001392707Mb.jpg","320x200":"https:\/\/static.www.suissealpine.sac-cas.ch\/1555335945_2001392707Mc.jpg","160x100":"https:\/\/static.www.suissealpine.sac-cas.ch\/1555335945_2001392707S.jpg","140x88":"https:\/\/static.www.suissealpine.sac-cas.ch\/1555335945_2001392707XS.jpg"},"permissions":{"archive":false,"recrop":false},"master":{"width":3500,"height":2187}}}],"route_id":4136,"show_end":true,"show_start":true,"style":"dashed","title":"Variant: on Chrüzplangg (north-west face)","type":"course","route_type":"mountain_hiking","discipline":"mountain_hiking"}],"seriousness":1,"teaser":"Gross Mythen, this mighty spire above Schwyz, is a landmark of Central Switzerland. Consequently, it is a very popular target for hikers. Most of them ascend it on the fairly easy normal route. Moreover, the cabin on the summit draws the crowds to the mountain. However, there are also more quiet itineraries to the top. One of the most rewarding is the route via Schafweg, Mythenmatt and Rot Grätli: entertaining, pleasurable, very sunny with great views – and wonderfully deserted.","teaser_title":"The steep rock spire above Schwyz","title":"Schafweg, Mythenmatt and Rot Grätli","type":"mountain_hiking","via_ferrata_ascent":null,"via_ferrata_descent":null,"waypoints":[{"description":"A col, which is passed on the variant.","id":191187,"name":"Zwischenmythen","reference_poi":{"altitude":1437,"description_summer":"Scharte zwischen Gross und Klein Mythen. Ein markierter Bergweg führt vom Alpthal über diesen Sattel nach Schwyz.","description_winter":null,"display_name":"Zwischenmythen","geom":{"type":"Point","coordinates":[2694588.7506408836,1209937.4384724291]},"id":8883,"linked_routes_by_discipline_denormalization":null,"main_lang":"de","type":"traverse"},"reference_poi_id":8883}],"permissions":{"update":false,"delete":false,"status_transitions":[],"is_locked":false,"unlock":false},"main_difficulty":"T5","route_info":{"list":[{"icon":"knob","label":"Difficulty","value":"T5","type":"difficulty","discipline":"mountain_hiking"},{"icon":"arrow2-top-right","label":"Ascent","value":"2 h"},{"icon":"arrow2-bottom-right","label":"Descent","value":"0:45 h"}]},"all_additional_informations":[{"label":"Departure and arrival point","description":{"title":"Holzegg, summit station (1405 m)","public_transport_stop_comment":"Information about the Brunni – Holzegg aerial cableway: http:\/\/www.brunnialpthal.ch","parking_lot":"","winter":"Right by the Brunni – Holzegg aerial cableway there is the Holzegg mountain hostel (sleeps 44 in rooms; on reservation only). More information at +41 41 811 12 34 or http:\/\/www.holzegg.ch","summer":"Right by the Brunni – Holzegg aerial cableway there is the Holzegg mountain hostel (sleeps 44 in rooms; on reservation only). More information at +41 41 811 12 34 or http:\/\/www.holzegg.ch"},"mapLink":{"label":"Show on map","options":"\"routeId\":\"4136\", \"segmentsMode\": \"true\", \"zoomLevel\":\"9\", \"poiId\":\"5486\", \"center\":[2695753.0666656,1209401.0333303]"},"googleMapsLink":{"label":"Get there Google Maps","typolink":"\/en\/redirect\/google-maps-routing\/lv03\/2695753.0666656\/1209401.0333303.gmaps","target":"_blank"}},{"label":"Time","description":{"description":"If you start at the Rotenfluebahn summit station, add 25 minutes (way up) and 35 minutes (way back). \nIf you start at Brunni (Holzeggbahn bottom station), add 55 minutes (way up) and 35 minutes (way back)."}},{"label":"Difficulty \/ Material","description":{"description":"The crux is the last stretch of the tour, Rot Grätli, where scrambling skills are required. Several bolts make sure that protecting with a rope is possible. The steep grassy face after leaving the normal route at bend 22 is around T4+. The same degree is for the exposed passages after this grassy face, which are equipped with fixed ropes, and the traversing of the steep ditch of a creek before Mythenmatt. The short tour is ideal for introducing beginners to the art of alpine hiking."}},{"label":"Waypoints","description":{"title":"Zwischenmythen (1437 m)","description":"A col, which is passed on the variant.","poiId":8883},"mapLink":{"label":"Show on map","options":"\"routeId\":\"4136\", \"segmentsMode\": \"true\", \"zoomLevel\":\"9\", \"poiId\":\"8883\", \"center\":[2694588.7506409,1209937.4384724]"}}],"discipline_season":"summer"}