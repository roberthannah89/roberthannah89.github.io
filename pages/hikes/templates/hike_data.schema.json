{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hike data file",
  "description": "Schema for <slug>.data.json. Validated by render_hike.py before rendering.",
  "type": "object",
  "required": ["page", "peak", "trailhead", "hero", "quick_facts", "photos",
               "waypoints", "routes", "index_card"],
  "additionalProperties": true,
  "properties": {
    "slug": { "type": "string" },
    "sources": {
      "type": "array",
      "description": "Golden sources: the authoritative websites this hike page is based on (e.g. SAC Route Portal, hikr.org, SwissTopo)",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "description": "Source name (e.g. 'SAC Route Portal')" },
          "url":  { "type": "string", "format": "uri", "description": "URL to the source page" }
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["title", "generated"],
      "properties": {
        "title": { "type": "string" },
        "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reports_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "year": { "type": "integer" }
      }
    },
    "peak": {
      "type": "object",
      "required": ["name", "elev", "lat", "lon"],
      "properties": {
        "name": { "type": "string" },
        "elev": { "type": "number" },
        "lat":  { "type": "number" },
        "lon":  { "type": "number" }
      }
    },
    "trailhead": {
      "type": "object",
      "required": ["name", "lat", "lon"],
      "properties": {
        "name":    { "type": "string" },
        "elev":    { "type": "number" },
        "lat":     { "type": "number" },
        "lon":     { "type": "number" },
        "sbb_url": { "type": "string" }
      }
    },
    "hero": {
      "type": "object",
      "required": ["image_url", "subtitle_html", "grade"],
      "properties": {
        "image_url":     { "type": "string" },
        "subtitle_html": { "type": "string" },
        "grade":         { "type": "string", "pattern": "^T[1-6][+-]?$" },
        "auto_subtitle": { "type": "boolean" }
      }
    },
    "index_card": {
      "type": "object",
      "required": ["region", "time"],
      "properties": {
        "region":     { "type": "string" },
        "time":       { "type": "string" },
        "distance":   { "type": "string" },
        "gain":       { "type": "string" }
      }
    },
    "quick_facts": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2, "maxItems": 2,
        "items": { "type": "string" }
      }
    },
    "photos": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["url", "alt", "caption_html"],
        "properties": {
          "url":          { "type": "string" },
          "alt":          { "type": "string" },
          "caption_html": { "type": "string" },
          "lightbox_url": { "type": "string" },
          "copyright":    { "type": "string" },
          "credit_date":  { "type": "string" }
        }
      }
    },
    "route_author": {
      "type": "object",
      "properties": {
        "name":         { "type": "string" },
        "bio_html":     { "type": "string" },
        "portrait_url": { "type": "string" }
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lat", "lon", "label", "kind"],
        "properties": {
          "lat":   { "type": "number" },
          "lon":   { "type": "number" },
          "label": { "type": "string" },
          "kind":  { "type": "string" }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title_html", "grade", "bullets_html", "source"],
        "properties": {
          "title_html":   { "type": "string" },
          "grade":        { "type": "string", "pattern": "^T[1-6][+-]?$" },
          "grade_label":  { "type": "string" },
          "pill_class":   { "type": "string" },
          "bullets_html": { "type": "array", "items": { "type": "string" } },
          "source":       { "type": "string", "description": "The original source where this route was discovered/documented (e.g., hikr.org, SAC guidebook, personal exploration)" }
        }
      }
    },
    "getting_there": {
      "type": "object",
      "properties": {
        "by_pt_html":      { "type": "string" }
      }
    },
    "end_point": {
      "type": "object",
      "description": "Set when a route is a traverse (start != end). Surfaced in the Endpoints section. Point-to-point hikes should populate sbb_url (via add_sac_hike_v2 or scripts/backfill_endpoint_sbb.py) so the transit widget's Return card queries the right station — falling back to end_point.name (e.g. 'Habergschwänd, Bergstation') sends a non-station string to opendata.ch and returns 0 connections.",
      "properties": {
        "name":    { "type": "string" },
        "elev":    { "type": ["number", "null"] },
        "lat":     { "type": ["number", "null"], "description": "Endpoint latitude (from GPX end when SAC doesn't specify)." },
        "lon":     { "type": ["number", "null"], "description": "Endpoint longitude (from GPX end when SAC doesn't specify)." },
        "sbb_url": { "type": "string", "description": "SAC-provided or nearest-station SBB timetable deep-link for the arrival side. Consumed by the transit widget's Return card. May be absent for mountain-hut endpoints with no nearby SBB station (widget falls back to trailhead station)." }
      }
    },
    "intro_html":      { "type": "string" },

    "elev_chart_attrib_html": { "type": "string" },
    "photos_attrib_html":     { "type": "string" }
  }
}
